{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xcoder:document-tools:excel:1",
  "title": "excel tool request",
  "description": "Read, create and update an Excel workbook (.xlsx / .xlsm).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "read"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sheet": {
          "type": "string",
          "maxLength": 64
        },
        "range": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9]\\d*(:[A-Z]{1,3}[1-9]\\d*)?$"
        },
        "maxCells": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 200000
        }
      },
      "required": [
        "op",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "create"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sheets": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 31
              },
              "rows": {
                "maxItems": 2000,
                "type": "array",
                "items": {
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 32000
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "name",
              "rows"
            ]
          }
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "path",
        "sheets"
      ]
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "const": "update"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "edits": {
          "minItems": 1,
          "maxItems": 5000,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "sheet": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 31
                  },
                  "cell": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 12
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 32000
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "sheet",
                  "cell",
                  "value"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "sheet": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 31
                  },
                  "row": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "values": {
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 32000
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "sheet",
                  "row",
                  "values"
                ]
              }
            ]
          }
        },
        "overwrite": {
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "path",
        "edits"
      ]
    }
  ]
}
