{
  "name": "litecoder",
  "version": "3.0.0",
  "description": "Plan one goal with a tool-less orchestrator, then delegate subtasks to concurrent ReAct worker agents (Kooder engine) from the command line.",
  "keywords": [
    "cli",
    "ai",
    "agent",
    "llm",
    "coding-agent",
    "orchestrator",
    "react",
    "worker",
    "automation"
  ],
  "license": "MIT",
  "author": "Neural Node Labs",
  "type": "module",
  "main": "./dist/litecoder/index.js",
  "types": "./dist/litecoder/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/litecoder/index.d.ts",
      "default": "./dist/litecoder/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "litecoder": "./dist/litecoder/cli.js",
    "kooder": "./dist/cli-worker.js",
    "worker": "./dist/cli-worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli-worker.ts",
    "dev:litecoder": "tsx src/litecoder/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@clack/prompts": "^0.7.0",
    "cheerio": "^1.2.0",
    "cli-spinners": "^2.9.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "js-yaml": "^5.2.2",
    "openai": "^7.4.0",
    "ora": "^8.1.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neural-node-labs/litecoder.git"
  },
  "bugs": {
    "url": "https://github.com/neural-node-labs/litecoder/issues"
  },
  "homepage": "https://github.com/neural-node-labs/litecoder#readme"
}
